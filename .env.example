# Copy this file to .env and adjust if needed. Never commit .env.

# Database
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_dev_password
POSTGRES_DB=finance_tracker
POSTGRES_PORT=5432

# Backend (ASP.NET Core) — host port mapped to the container's 8080
BACKEND_PORT=5000

# Frontend (Flutter web served by nginx)
FRONTEND_PORT=8080

# Login (JWT_KEY needs at least 32 characters; use your own value outside local development)
JWT_KEY=dev-only-key-change-me-0123456789abcdef
SEED_PASSWORD=change-me-dev-password

# Set to true only to skip login completely (every request runs as the dev user)
AUTH_DISABLED=false
